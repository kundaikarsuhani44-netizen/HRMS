# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Database (Supabase → Project Settings → Database → Connection string, "Transaction pooler", port 6543)
DATABASE_URL=

# --- Auth mode: "password" (login page, shared role passwords), "clerk", or "demo" (local only)
AUTH_MODE=password
# Any long random string (32+ chars) used to sign the session cookie (password / demo modes)
SESSION_SECRET=
# Password for HR Admin accounts
HR_PASSWORD=
# Password for managers and employees
EMPLOYEE_PASSWORD=

# --- Clerk (dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Email over SMTP (Brevo free tier: smtp-relay.brevo.com:587, or Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Public URL used in email links, e.g. https://kinara-hrms.vercel.app
APP_URL=http://localhost:3000

# --- HR assistant agent (Google AI Studio → Get API key; free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
AGENT_MODEL=gemini-2.5-flash
