{
  "name": "kinara-hrms",
  "version": "1.0.0",
  "private": true,
  "description": "Kinara HR \u2014 HRMS for Konkan Coastal Foods (Employee Master, Attendance, Leave, HR assistant agent)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent:eval": "tsx scripts/agent-eval.ts",
    "vercel-build": "tsx scripts/setup-db.ts && next build",
    "db:setup": "tsx scripts/setup-db.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.110",
    "@clerk/nextjs": "^6.39.8",
    "ai": "^5.0.289",
    "next": "^15.5.28",
    "nodemailer": "^7.0.6",
    "postgres": "^3.4.7",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "zod": "^3.25.76"
  }
}
